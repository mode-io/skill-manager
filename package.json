{
  "name": "skill-manager",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "main": "desktop/main/main.js",
  "scripts": {
    "dev": "VITE_API_BASE=/api vite --host 127.0.0.1 --port 5173",
    "dev:backend": "./.venv/bin/python -m skill_manager serve --host 127.0.0.1 --port 8000 --no-open-browser",
    "desktop:dev": "npm run build:release && electron .",
    "desktop:pack": "npm run build:release && electron-builder --mac --linux --dir",
    "desktop:build": "npm run build:release && electron-builder --mac --linux",
    "install:dev": "bash scripts/install-dev.sh",
    "start:dev": "bash scripts/start-dev.sh",
    "stop:dev": "bash scripts/stop-dev.sh",
    "version:sync": "python3 scripts/sync_version.py --check",
    "build:release": "./.venv/bin/python scripts/build_release.py",
    "build": "VITE_API_BASE=/api vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release-targets:check": "node scripts/check_release_targets_js.cjs",
    "codegen:openapi": "./.venv/bin/python scripts/dump_openapi.py && openapi-typescript frontend/src/api/openapi.json -o frontend/src/api/generated.ts",
    "codegen:check": "npm run codegen:openapi && git diff --exit-code frontend/src/api/openapi.json frontend/src/api/generated.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.95.2",
    "lucide-react": "^1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.mode.skill-manager",
    "productName": "Skill Manager",
    "directories": {
      "output": ".artifacts/desktop"
    },
    "files": [
      "desktop/main/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/skill-manager",
        "to": "backend/skill-manager",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "desktop/assets/icons",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  }
}
